{
  "name": "lore-client",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ui": "bun scripts/cdp-smoke.mjs",
    "test:visual": "bun scripts/visual-audit.mjs",
    "release:prepare": "bun scripts/prepare-release.mjs",
    "version:set": "bun scripts/set-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --config oxlint.config.ts src",
    "lint-fix": "oxlint --config oxlint.config.ts --fix src",
    "format": "oxfmt --config .oxfmtrc.json src .zed package.json oxlint.config.ts .oxfmtrc.json",
    "format:check": "oxfmt --config .oxfmtrc.json --check src .zed package.json oxlint.config.ts .oxfmtrc.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@pierre/theme": "2.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@oxlint/plugins": "1.78.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
