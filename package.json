{
  "name": "lore-client",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ui": "bun scripts/cdp-smoke.mjs",
    "test:visual": "bun scripts/visual-audit.mjs",
    "release:prepare": "bun scripts/prepare-release.mjs",
    "version:set": "bun scripts/set-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --config oxlint.config.ts src",
    "lint-fix": "oxlint --config oxlint.config.ts --fix src",
    "format": "oxfmt --config .oxfmtrc.json src .zed package.json oxlint.config.ts .oxfmtrc.json",
    "format:check": "oxfmt --config .oxfmtrc.json --check src .zed package.json oxlint.config.ts .oxfmtrc.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "@pierre/theme": "2.0.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@oxlint/plugins": "1.78.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
